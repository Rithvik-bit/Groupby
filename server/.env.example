# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# ─── MongoDB ──────────────────────────────────────────────────────────────────
# Standard local instance or replica set:
MONGO_URI=mongodb://127.0.0.1:27017/groupbuy

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=REPLACE_WITH_RANDOM_64_BYTE_HEX
JWT_REFRESH_SECRET=REPLACE_WITH_ANOTHER_RANDOM_64_BYTE_HEX
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Cookie ───────────────────────────────────────────────────────────────────
COOKIE_SECRET=REPLACE_WITH_RANDOM_32_BYTE_HEX

# ─── Providers ────────────────────────────────────────────────────────────────
# Email (dev: safe console logging without dumping secrets; prod: SMTP)
EMAIL_PROVIDER=console
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your@email.com
# SMTP_PASS=your_smtp_password
# EMAIL_FROM=noreply@groupbuy.app

# Payment (simulated: explicitly labeled non-real funds)
PAYMENT_PROVIDER=simulated

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# ─── Seed Data ────────────────────────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@groupbuy.dev
SEED_ADMIN_PASSWORD=Admin@123456
