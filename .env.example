# ==============================================================================
# GroupBuy Root Environment Configuration Template
# ==============================================================================
# Copy this file or individual service templates to .env before starting.
# IMPORTANT: Never commit actual .env files containing secrets to source control.

# ─── Server Configuration ─────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# ─── MongoDB Database ─────────────────────────────────────────────────────────
# Standard local MongoDB instance:
MONGO_URI=mongodb+srv://joshnasri92_db_user:<db_password>@cluster0.atqinbx.mongodb.net/?appName=Cluster0
# Note: Multi-document transactions require a replica set (e.g., mongod --replSet rs0).
# Standalone mode will run with graceful non-transactional fallback for local dev.

# ─── JWT Authentication ───────────────────────────────────────────────────────
# Generate high-entropy 64-byte hex keys:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=REPLACE_WITH_RANDOM_64_BYTE_HEX_FOR_ACCESS_TOKEN
JWT_REFRESH_SECRET=REPLACE_WITH_RANDOM_64_BYTE_HEX_FOR_REFRESH_TOKEN
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Cookie Signing ───────────────────────────────────────────────────────────
COOKIE_SECRET=REPLACE_WITH_RANDOM_32_BYTE_HEX_FOR_COOKIE_SIGNING

# ─── Email Provider ───────────────────────────────────────────────────────────
# Options: 'console' (development - safe console log without dumping secrets) or 'smtp'
EMAIL_PROVIDER=console
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your_user@example.com
# SMTP_PASS=your_password
# EMAIL_FROM=noreply@groupbuy.dev

# ─── Payment Provider ─────────────────────────────────────────────────────────
# Options: 'simulated' (development simulated provider with explicit disclaimers)
PAYMENT_PROVIDER=simulated

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# ─── Seed Data Credentials ───────────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@groupbuy.dev
SEED_ADMIN_PASSWORD=Admin@123456

# ─── Client Configuration ─────────────────────────────────────────────────────
VITE_API_BASE_URL=/api
VITE_SOCKET_URL=http://localhost:5000
