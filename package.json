{
  "name": "groupbuy-monorepo",
  "version": "1.0.0",
  "description": "GroupBuy — Collaborative Ownership & Resource-Sharing Platform",
  "private": true,
  "scripts": {
    "install:all": "cd server && npm install && cd ../client && npm install",
